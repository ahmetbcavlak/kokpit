<?xml version="1.0" encoding="utf-8"?>
<!--
  Kokpit kapı uyarısı (KapiServisi): only reads, never acts.
  - No packageNames on purpose: TYPE_WINDOWS_CHANGED has no package name and would be dropped
    (research decision 6). The service keeps com.hcn.autocan only, in code.
  - canRetrieveWindowContent + flagRetrieveInteractiveWindows: needed for TYPE_WINDOWS_CHANGED and getWindows().
  - Same flags as Keşif 0.6 (verified on the car). No flagIncludeNotImportantViews: it widens the node
    tree; if the popup text cannot be read on the car, 0.2 adds it.
  - notificationTimeout 0 (as Keşif 0.6, which caught the door popup on the car this way): with a delay
    the system keeps only the last pending event of a type, so another app's window event could replace
    the door popup's.
  - No canPerformGestures, no canRequestEnhancedWebAccessibility, no touch exploration, no key filtering.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/kapi_servisi_aciklama"
    android:notificationTimeout="0" />
