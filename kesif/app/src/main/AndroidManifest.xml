<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keşif 0.8: Bluetooth connection broadcasts and device names (Android 8.1 needs this one). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Keşif 0.8: GPS speed, only for the climate page's "parked" check. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keşif 0.9: open the system installer for a downloaded Keşif ("Güncellemeyi dene"); the user confirms. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Keşif 0.9: brightness test, only after the user grants it and confirms; the old value is put back. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Keşif 0.9: opening timeline (armed by the user, 24 h at most). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Newer Android versions hide other packages unless named; the CAN service check needs this one. -->
    <queries>
        <package android:name="com.hcn.autocan" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_kesif"
        android:label="Kokpit Keşif"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale|mcc|mnc"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Window event log (Keşif 0.6). Off until the user turns it on in Settings > Accessibility.
             Only the system may bind it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".PencereGunlugu"
            android:exported="true"
            android:label="@string/pencere_gunlugu_adi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pencere_gunlugu" />
        </service>
        <!-- Media sessions (Keşif 0.8). Off until the user allows notification access in Settings.
             Only the system may bind it. It reads; it never removes or answers a notification. -->
        <service
            android:name=".KesifBildirim"
            android:exported="true"
            android:label="@string/bildirim_adi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Keşif 0.9: the downloaded APK, read-only, for the system installer only (one-off grant). -->
        <provider
            android:name=".ApkSaglayici"
            android:authorities="dev.kokpit.kesif.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Keşif 0.9: boot time for the opening timeline. Only records a time; starts the measuring
             service only if the user armed it. -->
        <receiver android:name=".KesifAcilis" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_BOOT_IPO" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AcilisServisi"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
